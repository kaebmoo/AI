# ============================================================
# NT AI Assistant — Environment Configuration
# Copy this file to .env and fill in the values
# cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# RUNTIME ENVIRONMENT
# ------------------------------------------------------------
ENVIRONMENT=development

# เอกสาร OpenAPI เต็ม (/api/v1/docs, /redoc, /openapi.json) — ปิดเป็นค่าเริ่มต้น; เปิดเฉพาะเครื่องนักพัฒนา
# (มีทุก route รวม admin — ห้ามเปิดบน server ที่คนนอกเข้าถึงได้)
# API_DOCS_ENABLED=true

# ------------------------------------------------------------
# SECURITY (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------
SECRET_KEY=

# ------------------------------------------------------------
# DATABASE
# SQLite (default): sqlite:///./nt_fi_report.sqlite
# PostgreSQL:       postgresql://user:password@host:5432/dbname
# MS SQL Server:    mssql+pymssql://user:password@host/dbname
# ------------------------------------------------------------
DATABASE_URL=sqlite:///./nt_fi_report.sqlite
BUSINESS_DB_PATH=./nt_fi_report.sqlite
# DB_ENGINE=sqlite   # auto-detected from DATABASE_URL if not set

# ------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins
# Example: https://app.nt.th,https://admin.nt.th
# Use http://localhost:5173 for local development only
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:3000

# ------------------------------------------------------------
# REDIS (for caching and Celery)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# AI PROVIDER
# Options: claude, gemini, matcha
# ------------------------------------------------------------
AI_PROVIDER=matcha

# Matcha (NT Internal AI Gateway) — recommended for production
MATCHA_API_URL=https://aigateway.ntictsolution.com/v1/chat/completions
MATCHA_AI_API_KEY=
MATCHA_MODEL=gpt-4o
# Set to false only if the gateway uses a self-signed certificate
MATCHA_SSL_VERIFY=true
MATCHA_TIMEOUT=60.0

# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_EXTENDED_THINKING=false
CLAUDE_THINKING_BUDGET_TOKENS=8000

# Google AI (Gemini)
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# ------------------------------------------------------------
# EMAIL / OTP
# Set EMAIL_HOST=mock to disable real email (dev only)
# ------------------------------------------------------------
EMAIL_HOST=mock
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@nt.th

# Comma-separated list of allowed email domains for OTP login
# Example: nt.th,ntictsolution.com
# Leave empty to allow all domains
ALLOWED_EMAIL_DOMAINS=nt.th,ntictsolution.com

# OTP settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_MINUTES=1

# ------------------------------------------------------------
# SESSION & TOKEN
# ------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days
SESSION_EXPIRY_HOURS=24
SESSION_REFRESH_THRESHOLD_HOURS=1

# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------
LOGIN_RATE_LIMIT=5/minute
API_RATE_LIMIT=60/minute
CHAT_RATE_LIMIT=20/minute

# ------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------
TWO_PASS_ENABLED=false
VALUE_LOOKUP_ENABLED=false
TIER_CLASSIFICATION_ENABLED=false

# ------------------------------------------------------------
# RAG / VANNA
# ------------------------------------------------------------
VANNA_CHROMA_PATH=./chroma_db
VANNA_DISTANCE_THRESHOLD=1.8

# ------------------------------------------------------------
# FRONTEND CLIENTS
# Set these in frontend/.env and frontend-admin/.env for non-local environments
# ------------------------------------------------------------
# EXPO_PUBLIC_API_URL=https://your-api.example.com/api/v1
# VITE_API_URL=https://your-api.example.com/api/v1

# ------------------------------------------------------------
# TELEGRAM BOT
# ------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_BOT_MODE=polling            # polling (dev) | webhook (prod)
# TELEGRAM_WEBHOOK_URL=https://your-domain/telegram/webhook   # required in webhook mode (auto-registered at startup)
# TELEGRAM_WEBHOOK_SECRET=change-me    # X-Telegram-Bot-Api-Secret-Token verification

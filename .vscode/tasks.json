{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start All Services",
            "dependsOn": [
                "Backend",
                "Worker",
                "User-Frontend",
                "Admin-UI"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Backend",
            "type": "shell",
            "command": "source venv/bin/activate && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
        },
        {
            "label": "Worker",
            "type": "shell",
            "command": "source venv/bin/activate && celery -A app.celery worker -Q email-queue,celery --loglevel=info"
        },
        {
            "label": "User-Frontend",
            "type": "shell",
            "command": "cd frontend && npm run web"
        },
        {
            "label": "Admin-UI",
            "type": "shell",
            "command": "cd frontend-admin && npm run dev"
        }
    ]
}
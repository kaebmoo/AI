{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start All Services",
            "dependsOn": [
                "Check Redis",
                "Backend (FastAPI)",
                "Worker (Celery)",
                "User Frontend (Expo Web)",
                "Admin UI (Vite)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Stop All Services",
            "type": "shell",
            "command": "./start_services.sh stop",
            "problemMatcher": []
        },
        {
            "label": "Setup (install deps + init DB)",
            "type": "shell",
            "command": "./start_services.sh setup",
            "problemMatcher": []
        },
        {
            "label": "Check Redis",
            "type": "shell",
            "command": "redis-cli ping || { echo '❌ Redis not running → brew services start redis'; exit 1; }",
            "problemMatcher": []
        },
        {
            "label": "Backend (FastAPI)",
            "type": "shell",
            "command": "venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
            "isBackground": true,
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Uvicorn running on.*"
                }
            },
            "presentation": {
                "group": "nt-ai-assistant",
                "panel": "dedicated"
            }
        },
        {
            "label": "Worker (Celery)",
            "type": "shell",
            "command": "venv/bin/celery -A app.celery worker -Q email-queue,reports-queue,celery --loglevel=info",
            "isBackground": true,
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "celery@.*ready.*"
                }
            },
            "presentation": {
                "group": "nt-ai-assistant",
                "panel": "dedicated"
            }
        },
        {
            "label": "User Frontend (Expo Web)",
            "type": "shell",
            "command": "npm run web",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*Web is waiting on.*"
                }
            },
            "presentation": {
                "group": "nt-ai-assistant",
                "panel": "dedicated"
            }
        },
        {
            "label": "Admin UI (Vite)",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend-admin"
            },
            "isBackground": true,
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*Local:.*"
                }
            },
            "presentation": {
                "group": "nt-ai-assistant",
                "panel": "dedicated"
            }
        }
    ]
}
